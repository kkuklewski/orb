{
  "name": "orb-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Orb's page (React + TypeScript, built by Vite into src/orb/static/app)",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "gen:protocol": "json2ts -i src/protocol.schema.json -o src/protocol.gen.ts --bannerComment \"// Generated from src/orb/protocol.py (uv run orb-protocol && npm run gen:protocol). Do not edit.\" --unreachableDefinitions",
    "test": "vitest run"
  },
  "dependencies": {
    "dompurify": "3.4.17",
    "highlight.js": "11.12.0",
    "marked": "18.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "json-schema-to-typescript": "16.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
